// 冰地：移植自旧版 scene3d.js 的 STONE_FRAG。近处用画里的裂冰，叠细裂纹，边缘按半径淡出，接到远景。
CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: floor-vs:vert
      frag: floor-fs:frag
      priority: 100
      depthStencilState:
        depthTest: true
        depthWrite: true
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture: { value: white }
        baseColor:   { value: [0.824, 0.871, 0.925, 1], linear: true, editor: { type: color } }
        darkColor:   { value: [0.604, 0.678, 0.761, 1], linear: true, editor: { type: color } }
        lightColor:  { value: [0.953, 0.969, 0.988, 1], linear: true, editor: { type: color } }
        params:      { value: [8.2, 0.9, 0, 0.16], editor: { tooltip: 'x 半径, y 贴图混合, z 幻海强度, w 雾气（模拟旧版 ACES 的发白）' } }
}%

CCProgram floor-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  out vec3 v_world;
  out vec3 v_normal;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 wp = matWorld * position;
    v_world = wp.xyz;
    v_normal = normalize((matWorld * vec4(a_normal, 0.0)).xyz);
    return cc_matProj * cc_matView * wp;
  }
}%

CCProgram floor-fs %{
  precision highp float;
  #include <legacy/output>
  in vec3 v_world;
  in vec3 v_normal;
  uniform sampler2D mainTexture;
  uniform Constant {
    vec4 baseColor;
    vec4 darkColor;
    vec4 lightColor;
    vec4 params;
  };

  float hash21 (vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float crack (vec2 p) {
    float d = 1.0;
    for (int i = 0; i < 5; i++) {
      vec2 iv = floor(p), fv = fract(p);
      float m = 8.0;
      for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
        vec2 g = vec2(float(x), float(y));
        vec2 o = vec2(hash21(iv + g), hash21(iv + g + 17.13));
        vec2 r = g + o - fv;
        m = min(m, dot(r, r));
      }
      d = min(d, m); p = p * 1.9 + vec2(3.1, 1.7);
    }
    return smoothstep(0.012, 0.0, d);
  }

  vec4 frag () {
    float R = params.x, domain = params.z;
    vec3 n = normalize(v_normal);
    float lit = clamp(dot(n, normalize(vec3(0.35, 0.8, 0.4))), 0.0, 1.0);
    float rim = pow(1.0 - abs(n.y), 3.0);
    vec2 xz = v_world.xz;
    float r = length(xz);
    float veins = crack(xz * 1.15);
    vec3 col = mix(baseColor.rgb, darkColor.rgb, veins * 0.18);
    vec2 uv = vec2(xz.x / (R * 2.0) + 0.5, xz.y / (R * 2.0) + 0.55);
    vec3 tex = SRGBToLinear(texture(mainTexture, clamp(uv, 0.0, 1.0)).rgb);
    col = mix(col, tex, params.y);
    float sheen = pow(lit, 1.4) * 0.16;
    col = mix(col, lightColor.rgb, sheen + rim * 0.06);
    vec3 glow = mix(vec3(0.70, 0.84, 1.0), vec3(0.32, 0.52, 1.0), domain);
    col += glow * veins * (0.05 + domain * 0.16);
    col = mix(col, glow, domain * 0.12);
    // 旧版经过 ACES 色调映射，冰面偏白偏柔；这里用去饱和 + 向雾色靠拢来对齐观感
    float lum = dot(col, vec3(0.299, 0.587, 0.114));
    col = mix(col, vec3(lum), params.w * 0.8);
    col = mix(col, vec3(0.80, 0.85, 0.90), params.w);
    float fade = smoothstep(R * 0.98, R * 0.62, r);
    return CCFragOutput(vec4(col, fade));
  }
}%
